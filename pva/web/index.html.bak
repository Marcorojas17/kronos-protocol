.hero{max-width:1200px;margin:30px auto;padding:0 20px;text-align:center}
.hero h1{font-size:2.2rem;color:var(--gold);letter-spacing:4px;text-shadow:0 0 20px rgba(212,175,55,.5)}
.hero p{color:var(--neon);margin-top:8px;letter-spacing:2px;font-size:.9rem}
.core{margin:30px auto;max-width:900px;border:1px solid rgba(0,255,204,.4);padding:25px;border-radius:14px;background:rgba(0,15,10,.9);box-shadow:0 0 40px rgba(0,255,204,.1)}
input{width:100%;padding:16px;background:#000;border:1px solid var(--neon);border-radius:8px;color:var(--neon);font-family:monospace;letter-spacing:1px}
.btn{display:inline-block;margin-top:18px;padding:14px 32px;background:linear-gradient(90deg,var(--neon),var(--gold));color:#000;font-weight:900;border:none;border-radius:30px;letter-spacing:2px;cursor:pointer;box-shadow:0 0 25px rgba(0,255,204,.4);transition:.3s}
.btn:hover{transform:scale(1.05)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-top:30px;text-align:left}
.box{border:1px dashed #234;padding:15px;border-radius:10px;background:rgba(0,0,0,.4)}
.box b{color:var(--gold);display:block;margin-bottom:8px;font-size:.85rem}
.box ul{list-style:none;font-size:.78rem;line-height:1.6;color:#9ab}.box li::before{content:"▸ ";color:var(--neon)}
.sacred{margin-top:30px;display:grid;grid-template-columns:repeat(3,1fr);gap:15px;border:1px solid rgba(212,175,55,.3);padding:20px;border-radius:12px}
.sacred div{text-align:center}.sacred b{color:var(--neon);font-size:.9rem}
.footer{margin-top:30px;font-size:.65rem;color:#445;text-align:center;border-top:1px solid #111;padding:15px}
</style></head><body>
