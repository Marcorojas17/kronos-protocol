<style>
:root{--neon:#00ffcc;--gold:#D4AF37;--bg:#020806}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:#c0d8d3;font-family:'JetBrains Mono',monospace}
.top{padding:12px 20px;border-bottom:2px solid var(--neon);display:flex;justify-content:space-between;background:#05120f}
