for(var l=1;l<=L;l++){var r=(l/L)*180;var p=6+l*2;var o=0.3+(l/L)*0.7;x.strokeStyle='hsla('+(40+l*8)+',100%,60%,'+o+')';x.lineWidth=l===L?2:1;x.beginPath();for(var i=0;i<=p;i++){var a=(i/p)*Math.PI*2;var rr=r+15*Math.sin(sd+i*3.14);var px=cx+rr*Math.cos(a),py=cy+rr*Math.sin(a);if(i===0)x.moveTo(px,py);else x.lineTo(px,py)}x.closePath();x.stroke();
