async function chatEnviar(){
  const input = document.getElementById("chat-input");
  const mensaje = input.value.trim();
  if(!mensaje) return;
  input.value = "";
  const hist = document.getElementById("chat-hist");
  hist.innerHTML += '<div class="tl tp">Tú: ' + mensaje.replace(/</g,"&lt;") + '</div>';
  const espera = document.createElement("div");
  espera.className = "tl tif";
  espera.id = "chat-espera";
  espera.textContent = "■_□ pensando...";
  hist.appendChild(espera);
  hist.scrollTop = hist.scrollHeight;
  try {
    const r = await fetch("http://127.0.0.1:5000/api/chat", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({mensaje: mensaje})
    });
    const data = await r.json();
    document.getElementById("chat-espera").remove();
    if(data.ok){
      const resp = (data.respuesta || "").replace(/</g,"&lt;");
      hist.innerHTML += '<div class="tl to">■_□: ' + resp + '</div>';
    } else {
      hist.innerHTML += '<div class="tl te">Error: ' + data.error + '</div>';
    }
  } catch(e) {
    document.getElementById("chat-espera").remove();
    hist.innerHTML += '<div class="tl te">No se pudo conectar. Arranca: python3 ~/arkhe-zero/ia/api_ia.py</div>';
  }
  hist.scrollTop = hist.scrollHeight;
}
document.addEventListener("DOMContentLoaded", function(){
  const ci = document.getElementById("chat-input");
  if(ci) ci.addEventListener("keydown", function(e){
    if(e.key === "Enter") chatEnviar();
  });
});


async function md33Auditar(){
  const out = document.getElementById("md33-out");
  if(!out) return;
  out.innerHTML = "";
  const add = (t, c) => {
    const l = document.createElement("div");
    l.className = "tl " + (c || "to");
    l.textContent = t;
    out.appendChild(l);
    out.scrollTop = out.scrollHeight;
  };
  add("[MD-33] Iniciando auditoría forense...", "tc");
  add("[MD-33] Conectando con api_ia.py...", "tif");
  try {
    const r = await fetch("http://127.0.0.1:5000/api/md33");
    const data = await r.json();
    add("", "to");
    add("═══ " + data.modulo + " ═══", "tw");
    add("Sello: " + data.sello + " · Firma: " + data.firma, "tw");
    add("Total archivos: " + data.total, "tif");
    add("", "to");
    for(const a of data.archivos){
      add("▸ " + a.archivo, "tc");
      add("   SHA-256: " + a.sha256, "to");
      add("   Tamaño: " + a.tamano + " bytes · Estado: " + a.estado, "tw");
      add("   Timestamp: " + a.timestamp, "tif");
      add("", "to");
    }
    add("◯_● AUDITORÍA COMPLETA · 51/49/100", "tw");
  } catch(e) {
    add("[MD-33] Error: " + e.message, "te");
    add("Arranca api_ia.py: nohup python3 ~/arkhe-zero/ia/api_ia.py &", "tc");
  }
}
function md33Limpiar(){
  const out = document.getElementById("md33-out");
  if(out) out.innerHTML = '<div class="tl tif">Panel limpio.</div>';
}


async function cdScanReal(){
  const out = document.getElementById("cd-scan-out");
  if(!out) return;
  out.innerHTML = "";
  const add = (t, c) => {
    const l = document.createElement("div");
    l.className = "tl " + (c || "to");
    l.textContent = t;
    out.appendChild(l);
    out.scrollTop = out.scrollHeight;
  };
  add("[CD-SCAN] Iniciando escaneo real de puertos...", "tc");
  add("[CD-SCAN] Motor: api_scan.py (sockets TCP)", "tif");
  try {
    const r = await fetch("http://127.0.0.1:5001/api/scan", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({target: "127.0.0.1"})
    });
    const data = await r.json();
    add("", "to");
    add("Target: " + data.target, "tw");
    add("Total puertos escaneados: " + data.total, "tif");
    add("Abiertos: " + data.abiertos.length, "tw");
    add("", "to");
    for(const p of data.abiertos){
      let nombre = "desconocido";
      if(p===22) nombre = "SSH";
      else if(p===80) nombre = "HTTP";
      else if(p===443) nombre = "HTTPS";
      else if(p===8080) nombre = "ARKHÉ-WEB";
      else if(p===5001) nombre = "SCAN-API";
      else if(p===5000) nombre = "IA-API";
      add("▸ Puerto " + p + " (" + nombre + ") · ABIERTO", "tw");
    }
    add("", "to");
    add("Cerrados: " + data.cerrados.length, "tif");
    add("◯_● SCAN REAL COMPLETO · 51/49/100", "tw");
  } catch(e) {
    add("[CD-SCAN] Error: " + e.message, "te");
    add("Arranca api_scan: nohup python3 ~/arkhe-zero/ia/api_scan.py &", "tc");
  }
}
function cdLimpiarScan(){
  const out = document.getElementById("cd-scan-out");
  if(out) out.innerHTML = '<div class="tl tif">Panel limpio.</div>';
}

</script>
