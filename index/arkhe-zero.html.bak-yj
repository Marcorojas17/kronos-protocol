else{x.strokeStyle='rgba(255,215,0,0.7)';x.beginPath();for(var i=0;i<10;i++){var a=(i*Math.PI/5)+cyT;var r=i%2===0?150:60;var px=cx+r*Math.cos(a),py=cy+r*Math.sin(a);if(i===0)x.moveTo(px,py);else x.lineTo(px,py)}x.closePath();x.stroke()}
