    l.textContent = t;
    o.appendChild(l);
    o.scrollTop = o.scrollHeight;
  };
  try {
    const r = await fetch("http://127.0.0.1:5001/api/scan");
    const data = await r.json();
    add("> Target: " + data.target, "to");
    const info = [[22,"SSH"],[80,"HTTP"],[443,"HTTPS"],[8080,"ARKHE"],[5001,"IA"]];
    for(const [p,n] of info){
      const ab = data.abiertos.includes(p);
      add("> Puerto " + p + " (" + n + ") · " + (ab ? "ABIERTO" : "cerrado"), ab ? "tw" : "tif");
    }
    add("> Total escaneados: " + data.total, "tif");
    add("> ◯_● Puertos abiertos: " + data.abiertos.join(", "), "tw");
    add("> ◯_● ESCANEO COMPLETO · 51/49/100", "tw");
  } catch(e) {
    add(">>> ERROR: " + e.message, "te");
    add(">>> Stack: " + (e.stack || "sin stack"), "te");
  }
}

function dCy(){var c=document.getElementById('cyc');if(!c)return;var x=c.getContext('2d'),W=c.width,H=c.height,cx=W/2,cy=H/2;x.fillStyle='rgba(0,0,0,0.08)';x.fillRect(0,0,W,H);cyT+=0.02;
