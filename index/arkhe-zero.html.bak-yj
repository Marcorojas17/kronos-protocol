<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>◯_● ARKHÉ ZERO · ■_□ IA Local</title>
<style>
:root{--bg:#050507;--p:#0a0a0f;--p2:#0f0f18;--b:rgba(0,255,65,.18);--bg2:rgba(255,215,0,.35);--g:#00ff41;--gd:#00b32e;--y:#ffd700;--yd:#b39500;--pu:#7c5cff;--r:#ff3355;--cy:#00ffff;--t:#c8ffc8;--td:#6a8f6a}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--t);font-family:'Courier New',monospace;font-size:13px;line-height:1.5;min-height:100vh}
#app{display:grid;grid-template-columns:220px 1fr;grid-template-rows:50px 1fr 30px;min-height:100vh}
#hdr{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;padding:0 18px;background:linear-gradient(90deg,#050507,#0a0a12,#050507);border-bottom:1px solid var(--b)}
#hdr .lg{display:flex;gap:10px;align-items:center;color:var(--y);font-weight:bold;letter-spacing:.2em;font-size:14px;text-shadow:0 0 10px rgba(255,215,0,.5)}
#hdr .sl{font-size:20px;animation:pl 2s infinite}
@keyframes pl{0%,100%{opacity:.8}50%{opacity:1;text-shadow:0 0 20px rgba(255,215,0,1)}}
#hdr .st{display:flex;gap:14px;font-size:10px;color:var(--g);letter-spacing:.15em;align-items:center}
.dt{width:8px;height:8px;border-radius:50%;background:var(--g);box-shadow:0 0 10px var(--g);animation:bl 1.5s infinite;display:inline-block}
@keyframes bl{0%,100%{opacity:1}50%{opacity:.3}}
#sb{background:var(--p);border-right:1px solid var(--b);overflow-y:auto;padding:12px 0}
.ns{padding:9px 18px 5px;color:var(--yd);font-size:9px;letter-spacing:.2em;text-transform:uppercase;border-top:1px solid var(--b);margin-top:6px}
.ns:first-child{border-top:none;margin-top:0}
.ni{padding:7px 18px;color:var(--td);cursor:pointer;display:flex;gap:8px;font-size:11px;border-left:2px solid transparent;transition:all .2s}
.ni:hover{background:rgba(0,255,65,.05);color:var(--g);border-left-color:var(--g)}
.ni.ac{background:rgba(0,255,65,.08);color:var(--g);border-left-color:var(--y)}
.ni.dn{color:var(--r)}
.ni.dn:hover,.ni.dn.ac{color:var(--r);border-left-color:var(--r)}
#mn{overflow-y:auto;padding:22px 30px;background:radial-gradient(ellipse at top,#0a0a12,#050507 70%)}
#ft{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;padding:0 18px;background:var(--p);border-top:1px solid var(--b);font-size:10px;color:var(--td);letter-spacing:.15em}
#ft .sl{color:var(--y)}
.vw{display:none;animation:fi .4s}
.vw.ac{display:block}
@keyframes fi{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.vt{color:var(--y);font-size:20px;letter-spacing:.15em;margin-bottom:6px;text-shadow:0 0 15px rgba(255,215,0,.4)}
.vs{color:var(--td);font-size:11px;letter-spacing:.1em;margin-bottom:22px;padding-bottom:16px;border-bottom:1px solid var(--b)}
.pnl{background:var(--p2);border:1px solid var(--b);padding:16px;margin-bottom:16px;position:relative}
.pnl:before,.pnl:after{content:'';position:absolute;width:10px;height:10px}
.pnl:before{top:-1px;left:-1px;border-top:2px solid var(--y);border-left:2px solid var(--y)}
.pnl:after{bottom:-1px;right:-1px;border-bottom:2px solid var(--y);border-right:2px solid var(--y)}
.pt{color:var(--g);font-size:11px;letter-spacing:.2em;margin-bottom:11px;text-transform:uppercase}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}
pre{color:var(--g);font-size:10px;line-height:1.55;overflow-x:auto;padding:9px;background:rgba(0,255,65,.03);border-left:2px solid var(--gd);white-space:pre;font-family:inherit}
.bt{background:transparent;color:var(--g);border:1px solid var(--g);padding:7px 14px;font-family:inherit;font-size:10px;letter-spacing:.15em;cursor:pointer;text-transform:uppercase;transition:all .2s;margin-right:7px;margin-top:7px}
.bt:hover{background:var(--g);color:var(--bg);box-shadow:0 0 20px rgba(0,255,65,.5)}
.by{color:var(--y);border-color:var(--y)}.by:hover{background:var(--y);color:var(--bg)}
.br{color:var(--r);border-color:var(--r)}.br:hover{background:var(--r);color:var(--bg)}
.bc{color:var(--cy);border-color:var(--cy)}.bc:hover{background:var(--cy);color:var(--bg)}
.hr{text-align:center;padding:32px 18px;border:1px solid var(--bg2);background:radial-gradient(ellipse at center,rgba(255,215,0,.03),transparent 70%);margin-bottom:22px}
.hr .sb{font-size:52px;color:var(--y);text-shadow:0 0 40px rgba(255,215,0,.8);animation:pl 3s infinite}
.hr h1{font-size:34px;letter-spacing:.3em;color:var(--y);margin:14px 0 8px;text-shadow:0 0 30px rgba(255,215,0,.5)}
.hr .tg{font-size:14px;font-style:italic;margin-bottom:14px}
.hr .pc{display:flex;justify-content:center;gap:22px;margin-top:18px;font-size:12px;letter-spacing:.2em}
.hr .pc b{color:var(--y);font-size:18px;display:block}
.sc{background:var(--p2);border:1px solid var(--b);padding:14px;text-align:center}
.sc .n{color:var(--y);font-size:26px;font-weight:bold;text-shadow:0 0 15px rgba(255,215,0,.4)}
.sc .l{color:var(--td);font-size:9px;letter-spacing:.2em;text-transform:uppercase;margin-top:4px}
.tr{background:#000;border:1px solid var(--b);padding:11px;font-size:11px;color:var(--g);height:380px;overflow-y:auto;box-shadow:inset 0 0 40px rgba(0,255,65,.08)}
.ti{display:flex;gap:9px;align-items:center;margin-top:7px;background:#000;border:1px solid var(--b);padding:7px 11px}
.ti span{color:var(--y);font-size:11px}
.ti input{flex:1;background:transparent;border:none;color:var(--g);font-family:inherit;font-size:11px;outline:none}
.tl{margin-bottom:2px;font-size:11px}
.tp{color:var(--y)}.to{color:var(--g)}.te{color:var(--r)}.tif{color:var(--td)}.tw{color:var(--y)}.tc{color:var(--cy)}
.ac{background:var(--p2);border:1px solid var(--b);padding:12px;transition:all .3s;cursor:pointer}
.ac:hover{border-color:var(--y);transform:translateY(-3px)}
.ac .ai{font-size:22px;margin-bottom:5px}
.ac .an{color:var(--y);font-size:11px;letter-spacing:.15em;font-weight:bold}
.ac .ar{color:var(--td);font-size:9px;letter-spacing:.1em;margin-top:3px;text-transform:uppercase}
.ac.act{border-color:var(--g);box-shadow:0 0 30px rgba(0,255,65,.35)}
.ac.hu{border-color:var(--r)}
.if{width:100%;background:#000;border:1px solid var(--b);padding:9px 14px;color:var(--g);font-family:inherit;font-size:11px;outline:none;margin-bottom:9px}
.if:focus{border-color:var(--y)}
.ho{background:#000;border:1px solid var(--b);padding:11px;color:var(--g);font-size:10px;word-break:break-all;margin-top:9px;line-height:1.6}
.ho .lb{color:var(--y)}
.db{display:inline-block;padding:3px 7px;font-size:9px;letter-spacing:.1em;border:1px solid var(--gd);color:var(--g);margin-right:5px;margin-bottom:5px}
.db.r{border-color:var(--r);color:var(--r)}
.db.y{border-color:var(--y);color:var(--y)}
.db.p{border-color:var(--pu);color:var(--pu)}
.db.c{border-color:var(--cy);color:var(--cy)}
.atk{background:#0a0000;border:1px solid var(--r);padding:9px;margin-bottom:7px}
.atk.bl{background:#000a00;border-color:var(--g);opacity:.75}
.atk .ah{display:flex;justify-content:space-between;margin-bottom:4px;font-size:10px}
.atk .at{color:var(--r);font-weight:bold;letter-spacing:.12em}
.atk.bl .at{color:var(--g)}
.atk .am{color:var(--td);font-size:9px}
.atk .ad{font-size:9px;color:var(--td);line-height:1.5}
.ld{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--r);box-shadow:0 0 10px var(--r);animation:bl .8s infinite;margin-right:5px}
#ts{position:fixed;bottom:45px;right:22px;background:var(--p);border:1px solid var(--y);padding:12px 20px;color:var(--y);font-size:11px;letter-spacing:.1em;box-shadow:0 0 30px rgba(255,215,0,.4);transform:translateY(200%);transition:transform .4s;z-index:999;max-width:320px}
#ts.sh{transform:translateY(0)}
#ts.dg{border-color:var(--r);color:var(--r)}
canvas{display:block;max-width:100%}
.cb{background:#000;border:1px solid var(--b);padding:9px;display:flex;justify-content:center;min-height:300px}
.pjc{background:var(--p2);border:1px solid var(--b);padding:14px;margin-bottom:11px;cursor:pointer;transition:all .3s}
.pjc:hover{border-color:var(--y);transform:translateX(5px)}
.pjc .pn{color:var(--y);font-size:10px;letter-spacing:.2em}
.pjc .pm{color:var(--g);font-size:15px;letter-spacing:.15em;margin:4px 0;font-weight:bold}
.pjc .pd{color:var(--td);font-size:10px}
@media(max-width:900px){#app{grid-template-columns:55px 1fr}.ni span:not(.ic){display:none}.ns{font-size:8px;padding:9px 5px 4px}.ni{justify-content:center;padding:11px 5px}.g2,.g3,.g4{grid-template-columns:1fr}#mn{padding:16px}.hr h1{font-size:22px}}
</style>
</head>
<body>
<div id="app">
<header id="hdr">
<div class="lg"><span class="sl">◯_●</span><span>ARKHÉ ZERO</span></div>
<div class="st"><div><span class="dt"></span>ACTIVO</div><div style="color:var(--y)">YHDRYH-92CE</div><div id="ck"></div></div>
</header>
<aside id="sb">
<div class="ns">Principal</div>
<div class="ni ac" data-v="dash"><span class="ic">◆</span><span>Dashboard</span></div>
<div class="ni" data-v="idx"><span class="ic">◆</span><span>Índice Cero</span></div>
<div class="ns">Seguridad</div>
<div class="ni dn" data-v="cd"><span class="ic">🛡</span><span>Ciberdefensa</span></div>
<div class="ni dn" data-v="kl"><span class="ic">🐉</span><span>Terminal Kali</span></div>
<div class="ni" data-v="cr"><span class="ic">🔐</span><span>Criptografía</span></div>
<div class="ns">Enjambre</div>
<div class="ni" data-v="ag"><span class="ic">🤖</span><span>13 Agentes</span></div>
<div class="ni" data-v="md33"><span class="ic">🔍</span><span>MD-33 Forense</span></div>
<div class="ni" data-v="chat"><span class="ic">💬</span><span>Hablar con IA</span></div>
<div class="ni dn" data-v="hu"><span class="ic">🎯</span><span>Agente 096</span></div>
<div class="ns">Visual</div>
<div class="ni" data-v="cy"><span class="ic">🎵</span><span>Cymatic</span></div>
<div class="ni" data-v="yj"><span class="ic">✨</span><span>Yejidá</span></div>
<div class="ns">Sistema</div>
<div class="ni" data-v="pj"><span class="ic">📁</span><span>Portfolio</span></div>
<div class="ni" data-v="tr"><span class="ic">⌨</span><span>Terminal</span></div>
<div class="ni" data-v="fr"><span class="ic">✍</span><span>Firma</span></div>
</aside>
<main id="mn">

<div class="vw ac" id="v-dash">
<div class="hr"><div class="sb">◯_●</div><h1>ARKHÉ ZERO</h1><p class="tg">"El legado no se hereda. Se firma."</p>
<div class="pc"><div><b>51%</b><span>HUMANO</span></div><div><b>49%</b><span>IA</span></div><div><b>100%</b><span>REAL</span></div></div></div>
<div class="g4">
<div class="sc"><div class="n">24</div><div class="l">Secciones</div></div>
<div class="sc"><div class="n">1070</div><div class="l">Archivos</div></div>
<div class="sc"><div class="n">13</div><div class="l">Agentes</div></div>
<div class="sc"><div class="n" style="color:var(--r)" id="dt">0</div><div class="l">Amenazas</div></div>
</div>
<div class="pnl" style="margin-top:22px"><div class="pt">◆ Estado del Sistema</div>
<pre>┌─────────────────────────────────────────────────────────────┐
│  ÍNDICE CERO ................ [ SELLADO ✓ ]                 │
│  PACTO 51/49 ................ [ OPERATIVO ✓ ]               │
│  ENJAMBRE ARKHÉ ............. [ 13/13 ACTIVOS ✓ ]           │
│  CRIPTOGRAFÍA PQC ........... [ ML-KEM · ML-DSA · SLH-DSA ] │
│  CIBERDEFENSA ............... [ ACTIVA ✓ ]                  │
│  FIRMA KINTSUGI ............. [ ◯_● · 51/49/100 ]           │
└─────────────────────────────────────────────────────────────┘</pre></div>
<div class="pnl"><div class="pt">◆ Acciones Rápidas</div>
<button class="bt br" onclick="go('cd')">🛡 Ciberdefensa</button>
<button class="bt br" onclick="go('kl')">🐉 Kali</button>
<button class="bt bc" onclick="go('cr')">🔐 Cripto</button>
<button class="bt by" onclick="go('hu')">🎯 Hunter</button></div>
</div>

<div class="vw" id="v-idx">
<h2 class="vt">◆ ÍNDICE CERO</h2><p class="vs">KRONOS · Arquitectura de Legado Digital · 2607146379465</p>
<div class="pnl"><div class="pt">◆ ADN Criptográfico</div>
<div class="ho">
<div><span class="lb">Safe Creative:</span> 2607146379465</div>
<div><span class="lb">Co-creatividad:</span> 2607086319439</div>
<div><span class="lb">SHA-256:</span> f03f7e2d852617309457e0fe207f8f8bd2627d0b723de02f3b0ce05767219112</div>
<div><span class="lb">Ethereum:</span> 0xd2c2a7e128e6c81b689b3b0d9e1b31a4f6f8df0391b7b6c05e7daa7fb895774c</div>
<div style="color:var(--y);margin-top:8px">🔒 SELLADO · VERIFICABLE · ETERNO</div></div></div>
<div class="pnl"><div class="pt">◆ Verificar Hash SHA-256</div>
<input class="if" id="vi" placeholder="Escribe algo...">
<button class="bt by" onclick="vfy()">◆ VERIFICAR</button>
<div id="vo" class="ho" style="display:none"></div></div>
</div>

<div class="vw" id="v-cd">
<h2 class="vt">🛡 CIBERDEFENSA</h2><p class="vs">Defensa PQC activa · Monitoreo en tiempo real</p>
<div class="g4">
<div class="sc"><div class="n" style="color:var(--g)">247</div><div class="l">Defensas</div></div>
<div class="sc"><div class="n" style="color:var(--r)" id="ca">0</div><div class="l">Ataques</div></div>
<div class="sc"><div class="n" style="color:var(--y)" id="cb">0</div><div class="l">Bloqueados</div></div>
<div class="sc"><div class="n" style="color:var(--cy)">100%</div><div class="l">Uptime</div></div></div>
<div class="pnl" style="margin-top:22px"><div class="pt"><span class="ld"></span>Centro de Comando</div>
<div style="text-align:center;padding:18px">
<div style="font-size:44px;color:var(--g);text-shadow:0 0 30px var(--g)" id="tl">NIVEL 1</div>
<div style="color:var(--td);font-size:10px;letter-spacing:.15em;margin-top:8px">SISTEMA PROTEGIDO · PQC ACTIVA</div></div>
<div style="margin-top:12px">
<div class="db">ML-KEM-1024</div><div class="db">ML-DSA-87</div><div class="db">SLH-DSA</div>
<div class="db y">eIDAS QTSA</div><div class="db c">C2PA v2.1</div><div class="db p">Crypto-Agility</div></div></div>

<div class="pnl">
<div class="pt">◆ SCAN REAL DE PUERTOS</div>
<p style="font-size:11px;color:var(--td);margin-bottom:10px">Escaneo de sockets TCP reales. No simulación.</p>
<button class="bt by" onclick="cdScanReal()">🔍 EJECUTAR SCAN REAL</button>
<button class="bt bc" onclick="cdLimpiarScan()">🗑 LIMPIAR</button>
<div id="cd-scan-out" style="margin-top:12px;background:#000;border:1px solid var(--b);padding:12px;min-height:180px;font-size:11px;line-height:1.6;color:var(--g)">
<div class="tl tif">Presiona SCAN REAL para auditar el sistema.</div>
</div>
</div>
<div class="pnl"><div class="pt">◆ Simular Ataque</div>
<button class="bt br" onclick="atk('SQL_INJECTION')">💉 SQL Injection</button>
<button class="bt br" onclick="atk('DDoS')">💥 DDoS</button>
<button class="bt br" onclick="atk('MITM')">🕵️ MITM</button>
<button class="bt br" onclick="atk('QUANTUM')">⚛️ Cuántico</button>
<button class="bt br" onclick="atk('RANSOMWARE')">🔒 Ransomware</button>
<button class="bt br" onclick="atk('ZERO_DAY')">🚨 Zero-Day</button></div>
<div class="pnl"><div class="pt">◆ Registro de Amenazas</div>
<div id="tlog" style="max-height:280px;overflow-y:auto;background:#000;border:1px solid var(--b);padding:11px">
<div style="color:var(--td);font-size:10px">> Sistema en espera...</div></div></div>
</div>

<div class="vw" id="v-kl">
<h2 class="vt">🐉 TERMINAL KALI</h2><p class="vs">Simulación Red Team · Herramientas de pentesting</p>
<div class="pnl"><div class="pt">◆ Comandos Rápidos</div>
<button class="bt bc" onclick="kc('nmap')">nmap</button>
<button class="bt bc" onclick="kc('ffuf')">ffuf</button>
<button class="bt bc" onclick="kc('nxc')">nxc smb</button>
<button class="bt bc" onclick="kc('gobuster')">gobuster</button>
<button class="bt bc" onclick="kc('hydra')">hydra</button>
<button class="bt bc" onclick="kc('msf')">msfconsole</button>
<button class="bt br" onclick="kc('clear')">Limpiar</button></div>
<div class="pnl"><div class="pt">◆ Terminal Kali</div>
<div class="tr" id="ko">
<div class="tl tif">┌──(kali㉿kali)-[~]</div>
<div class="tl tif">└─$ <span style="color:var(--g)">Escribe "help"</span></div></div>
<div class="ti"><span>┌──(kali㉿kali)-[~]</span><span style="color:var(--g)">└─$</span>
<input id="ki" placeholder="nmap, ffuf, nxc..." autocomplete="off"></div></div>
</div>

<div class="vw" id="v-cr">
<h2 class="vt">🔐 CRIPTOGRAFÍA PQC</h2><p class="vs">Post-Quantum · FIPS 203/204/205</p>
<div class="g3">
<div class="pnl"><div class="pt">◆ ML-KEM</div><div style="font-size:10px;color:var(--td)">FIPS 203 · Nivel 5</div><div style="color:var(--g);margin-top:6px;font-size:11px">Encapsulamiento</div></div>
<div class="pnl"><div class="pt">◆ ML-DSA</div><div style="font-size:10px;color:var(--td)">FIPS 204 · Nivel 5</div><div style="color:var(--g);margin-top:6px;font-size:11px">Firmas digitales</div></div>
<div class="pnl"><div class="pt">◆ SLH-DSA</div><div style="font-size:10px;color:var(--td)">FIPS 205</div><div style="color:var(--g);margin-top:6px;font-size:11px">Larga duración</div></div></div>
<div class="pnl"><div class="pt">◆ Generador SHA-256 Real</div>
<input class="if" id="hi" placeholder="Texto a hashear...">
<button class="bt" onclick="gh()">🔐 SHA-256</button>
<button class="bt by" onclick="sp()">✍ FIRMAR ML-DSA-87</button>
<div id="ho" class="ho" style="display:none"></div></div>
</div>

<div class="vw" id="v-ag">
<h2 class="vt">🤖 ENJAMBRE ARKHÉ</h2><p class="vs">13 agentes · 6 culturales + 6 oficios + 096 Hunter</p>
<div class="pt" style="margin-top:14px">◆ Culturales</div>
<div class="g3" id="agc"></div>
<div class="pt" style="margin-top:22px">◆ Oficios</div>
<div class="g3" id="ago"></div>
<div class="pnl" style="margin-top:22px"><div class="pt">◆ Log del Enjambre</div>
<div id="agl" style="font-size:11px;color:var(--g);height:150px;overflow-y:auto;background:#000;padding:11px;border:1px solid var(--b)">
<div class="tl tif">> En espera...</div></div>
<button class="bt" onclick="asw()">◆ ACTIVAR</button></div>
</div>

<div class="vw" id="v-hu">
<h2 class="vt" style="color:var(--r)">🎯 AGENTE 096 · EL CAZADOR</h2>
<p class="vs">Ciberseguridad ofensiva · Red Team · Auditoría ética</p>
<div class="pnl" style="border-color:var(--r)"><div style="display:flex;gap:16px;align-items:center">
<div style="font-size:58px">🎯</div>
<div><div style="color:var(--r);font-size:18px;letter-spacing:.2em;font-weight:bold">AGENTE 096</div>
<div style="color:var(--td);font-size:11px;letter-spacing:.15em;margin-top:4px">"EL CAZADOR" · Ciberdefensa Ofensiva</div>
<div style="margin-top:9px"><div class="db r">Red Team</div><div class="db r">Pentesting</div><div class="db r">OSINT</div></div></div></div></div>
<div class="pnl"><div class="pt">◆ Panel de Caza</div>
<div class="tr" id="hout" style="height:240px">
<div class="tl te">> [HUNTER-096] Inicializando...</div>
<div class="tl to">> [HUNTER-096] Esperando orden de caza.</div></div>
<button class="bt br" onclick="hh()">🎯 INICIAR CAZA</button>
<button class="bt bc" onclick="hs()">🔍 ESCANEO</button></div>
</div>

