#!/bin/bash
OUT=~/arkhe-zero/index/data.json
mkdir -p ~/arkhe-zero/index
UPTIME=$(uptime | awk -F'up' '{print $2}' | awk -F',' '{print $1}' | xargs)
KERNEL=$(uname -r)
IP=$(ip route 2>/dev/null | grep -v default | grep -v "127.0.0.1" | awk '{print $9}' | head -1)
[ -z "$IP" ] && IP="10.0.0.1"
HASH=$(echo -n "arkhe-zero-$(date +%s)" | sha256sum | awk '{print $1}')
TS=$(date -Iseconds)
cat > "$OUT" << JSON
{
  "nodo": "YHDRYH-92CE",
  "sello": "SCDR-001",
  "timestamp": "$TS",
  "uptime": "$UPTIME",
  "kernel": "$KERNEL",
  "ip": "$IP",
  "hash": "$HASH",
  "pacto": "51/49/100",
  "safe_creative": "2607146379465",
  "sha_root": "f03f7e2d852617309457e0fe207f8f8bd2627d0b723de02f3b0ce05767219112",
  "agentes": 13,
  "amenazas_bloqueadas": $(wc -l < ~/arkhe-zero/logs/defensa.log 2>/dev/null || echo 0)
}
JSON
echo "✓ data.json actualizado"
