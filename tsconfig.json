{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "docs/**/*"],
  "exclude": [
    "agents/**/*",
    "certificacion/**/*",
    "cimiento/**/*",
    "crypto/**/*",
    "gobernanza/**/*",
    "provenance/**/*",
    "node_modules",
    "docs",
    "main"
  ]
}
