# WALLET · PERSISTENCIA LOCAL
# ─────────────────────────────────────────────────────────────────────────────
WALLET_PATH = Path("wallet.json")


def cargar_wallet():
    if not WALLET_PATH.exists():
        return {
            "version": "kronos-1.0",
            "creado": datetime.now(timezone.utc).isoformat(),
            "balance": 0.0,
            "bloques": [],
            "ultimo_hash": "0" * 64,
        }
    with open(WALLET_PATH, "r", encoding="utf-8") as f:
        return json.load(f)


def guardar_wallet(wallet):
    with open(WALLET_PATH, "w", encoding="utf-8") as f:
        json.dump(wallet, f, indent=4, ensure_ascii=False)


# ─────────────────────────────────────────────────────────────────────────────
# NÚCLEO · HASH CHAIN + PRUEBA DE TRABAJO + FIRMA
# ─────────────────────────────────────────────────────────────────────────────
DIFICULTAD = "0000"
RECOMPENSA_BASE = 72


def calcular_hash(indice, timestamp, nonce, hash_previo, datos):
    payload = f"{indice}|{timestamp}|{nonce}|{hash_previo}|{datos}".encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def minar_bloque(indice, hash_previo, priv, wallet):
    timestamp = datetime.now(timezone.utc).isoformat()
    datos = f"recompensa={RECOMPENSA_BASE};fundador=KRONOS_PROTOCOL"

    print(f"\n{C.GOLD_2}◆ Minando Bloque #{indice}...{C.RESET}")
    nonce = 0
    inicio = time.time()

    while True:
        h = calcular_hash(indice, timestamp, nonce, hash_previo, datos)

        if nonce % 50_000 == 0 and nonce > 0:
            print(
                f"  {C.DIM}{C.CYAN}intentos {nonce:>9}  ·  hash {h[:24]}…{C.RESET}"
            )

        if h.startswith(DIFICULTAD):
            duracion = time.time() - inicio
            # Firma Ed25519 del bloque completo
            firma = firma_hex(priv, bytes.fromhex(h))

            print(f"{C.GOLD}>>> BLOQUE ENCONTRADO! <<<{C.RESET}")
            print(f"  {C.CREAM}Bloque    :{C.RESET} {C.GOLD_2}{indice}{C.RESET}")
            print(f"  {C.CREAM}Nonce     :{C.RESET} {C.GOLD_2}{nonce}{C.RESET}")
            print(f"  {C.CREAM}Hash      :{C.RESET} {C.GOLD_2}{h}{C.RESET}")
            print(f"  {C.CREAM}Prev Hash :{C.RESET} {C.DIM}{hash_previo[:32]}…{C.RESET}")
            print(f"  {C.CREAM}Firma     :{C.RESET} {C.DIM}{firma[:48]}…{C.RESET}")
            print(f"  {C.CREAM}Tiempo    :{C.RESET} {C.GOLD_2}{duracion:.2f}s{C.RESET}")

            return {
                "bloque": indice,
                "timestamp": timestamp,
                "nonce": nonce,
                "hash_previo": hash_previo,
                "hash": h,
                "firma_ed25519": firma,
                "datos": datos,
                "recompensa": RECOMPENSA_BASE,
                "duracion_seg": round(duracion, 3),
            }

        nonce += 1


