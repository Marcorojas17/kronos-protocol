    hash_previo = wallet["ultimo_hash"]

    try:
        while True:
            bloque = minar_bloque(bloque_actual, hash_previo, priv, wallet)
            wallet["bloques"].append(bloque)
            wallet["balance"] += bloque["recompensa"]
            wallet["ultimo_hash"] = bloque["hash"]
            guardar_wallet(wallet)

            print(
                f"  {C.GREEN}✓ Recompensa:{C.RESET} "
                f"{C.GOLD_2}{bloque['recompensa']} KRONOS{C.RESET}"
