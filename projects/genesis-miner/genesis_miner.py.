# ─────────────────────────────────────────────────────────────────────────────
# IDENTIDAD CRIPTOGRÁFICA (Ed25519)
# ─────────────────────────────────────────────────────────────────────────────
KEY_DIR = Path(".kronos_keys")
KEY_DIR.mkdir(exist_ok=True)
PRIV_PATH = KEY_DIR / "identity.key"
PUB_PATH  = KEY_DIR / "identity.pub"


def cargar_o_crear_identidad():
    """Genera o carga la clave privada Ed25519 del fundador."""
    if not ED25519_DISPONIBLE:
        return None, None

    if PRIV_PATH.exists() and PUB_PATH.exists():
        priv_bytes = PRIV_PATH.read_bytes()
        priv = Ed25519PrivateKey.from_private_bytes(priv_bytes)
        pub = priv.public_key()
        return priv, pub

    priv = Ed25519PrivateKey.generate()
    pub = priv.public_key()

    priv_bytes = priv.private_bytes(
        encoding=serialization.Encoding.Raw,
        format=serialization.PrivateFormat.Raw,
        encryption_algorithm=serialization.NoEncryption(),
    )
    pub_bytes = pub.public_bytes(
        encoding=serialization.Encoding.Raw,
        format=serialization.PublicFormat.Raw,
    )

    PRIV_PATH.write_bytes(priv_bytes)
    PUB_PATH.write_bytes(pub_bytes)
    return priv, pub


def firma_hex(priv, mensaje: bytes):
    if priv is None:
        return "SIN_FIRMA_ED25519"
    return priv.sign(mensaje).hex()


