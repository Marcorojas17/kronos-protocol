                f"{C.CREAM}Nuevo balance:{C.RESET} "
                f"{C.GOLD_2}{wallet['balance']} KRONOS{C.RESET}"
            )
            linea()

            bloque_actual += 1
            hash_previo = bloque["hash"]
            time.sleep(0.3)

    except KeyboardInterrupt:
        print(f"\n\n{C.AMBER}▸ Motor detenido por el fundador.{C.RESET}")
        print(f"{C.CREAM}  Balance final: {C.GOLD_2}{wallet['balance']} KRONOS{C.RESET}")
        print(f"{C.CREAM}  Bloques minados: {C.GOLD_2}{len(wallet['bloques'])}{C.RESET}")
        print(f"{C.DIM}  Estado persistido en wallet.json{C.RESET}\n")


if __name__ == "__main__":
