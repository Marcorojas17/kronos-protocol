{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Marcorojas17/kronos-protocol/00-SCHEMA/registro.schema.json",
  "title": "Registro KRONOS-KODICE-kronos360",
  "schema_version": "2.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "tipo",
    "interaction_id",
    "timestamp",
    "responsable",
    "payload_hash",
    "hash_algoritmo",
    "prev_hash",
    "hash_registro",
    "firma"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0", "2.0.0"]
    },
    "tipo": {
      "type": "string",
      "enum": [
        "articulo-constitucional",
        "documento-fundacional",
        "certificado-kodice",
        "acto-agente",
        "aprobacion-humana",
        "anclaje-externo",
        "evidencia-kronos360"
      ]
    },
    "interaction_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "responsable": {
      "type": "object",
      "required": ["id", "tipo"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "tipo": {
          "type": "string",
          "enum": [
            "fundador",
            "agente-kintsugi",
            "operador-kodice",
            "ciudadano",
            "institucion",
            "operador-kronos360"
          ]
        }
      }
    },
    "hash_algoritmo": {
      "type": "string",
      "enum": ["SHA-256", "SHA3-512"],
      "description": "Algoritmo del payload_hash. KRONOS usa SHA-256. kronos360 usa SHA3-512."
    },
    "payload_hash": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
    "prev_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hash_registro": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
    "firma": {
      "type": "object",
      "required": ["algoritmo", "firma_hex", "firmante"],
      "additionalProperties": false,
      "properties": {
        "algoritmo": {
          "type": "string",
          "enum": ["Ed25519", "ML-DSA-65", "hibrido"]
        },
        "firma_hex": {
          "type": "string",
          "description": "Firma en hex. Ed25519: 128 chars. ML-DSA-65: variable. Hibrido: objeto."
        },
        "firmante": { "type": "string" },
        "atestacion": {
          "type": "object",
          "required": ["firma_hex", "firmante"],
          "additionalProperties": false,
          "properties": {
            "firma_hex": { "type": "string" },
            "firmante": { "type": "string" }
          }
        },
        "firmas": {
          "type": "array",
          "description": "Usado cuando algoritmo = hibrido. Array de firmas individuales.",
          "items": {
            "type": "object",
            "required": ["algoritmo", "firma_hex", "firmante"],
            "additionalProperties": false,
            "properties": {
              "algoritmo": {
                "type": "string",
                "enum": ["Ed25519", "ML-DSA-65"]
              },
              "firma_hex": { "type": "string" },
              "firmante": { "type": "string" }
            }
          }
        }
      }
    },
    "economia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "gratuito",
            "pago-unico",
            "suscripcion",
            "licencia",
            "seguro"
          ]
        },
        "emisor_id": { "type": "string" },
        "receptor_id": { "type": "string" },
        "licencia_operador": { "type": "string" },
        "monto": { "type": "number", "minimum": 0 },
        "moneda": { "type": "string", "enum": ["MXN", "USD", "USDC", "EUR"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
